---

---

<section id="home" class="hero reveal">
  <div class="pixel-logo">
    <svg width="49" height="49" viewBox="0 0 7 7" fill="currentColor">
      <rect x="2" y="0" width="1" height="1"></rect>
      <rect x="0" y="2" width="1" height="1"></rect>
      <rect x="1" y="3" width="1" height="1"></rect>
      <rect x="2" y="4" width="1" height="1"></rect>
      <rect x="3" y="3" width="1" height="1"></rect>
      <rect x="4" y="2" width="1" height="1"></rect>
    </svg>
  </div>
  <h1 class="hero-heading text-pixel">ABHIJIT SWAIN</h1>
  <p class="hero-info-text">Software Engineer based in Odisha, India</p>
  <p class="hero-info-text">Founder of Team Origin Logic</p>
  <p class="hero-terminal-line">
    Not available for work<span class="cursor">_</span>
  </p>
  <div class="hero-actions">
    <a href="#projects" class="button">Projects</a>
    <a href="#contact" class="button">Contact</a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  @keyframes blink-dot {
    50% {
      opacity: 0;
    }
  }

  .pixel-logo {
    display: flex,
    justify-content: center,
    align-items: center,
    width: 49px;
    height: 49px;
    margin-bottom: 1rem;
  }

  .pixel-logo svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-heading {
    font-size: 3.5em;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .hero-info-text {
    font-size: 1.2em;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .hero-terminal-line {
    font-family: var(--font-body);
    font-size: 1.1em;
    margin-top: 2rem;
    margin-bottom: 3rem;
  }

  .cursor {
    animation: blink 1s steps(1) infinite;
    display: inline-block;
    width: 0.7em;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
  }

  .button {
    display: inline-block;
    border: 1px solid var(--color-border-strong);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    text-transform: uppercase;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .button:hover {
    background-color: var(--color-fg);
    color: var(--color-bg);
  }

  @media (max-width: 680px) {
    .hero-heading {
      font-size: 2.8em;
    }

    .hero-tagline {
      font-size: 1em;
    }

    .hero-actions {
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero-heading {
      font-size: 2.2em;
    }
  }
</style>
