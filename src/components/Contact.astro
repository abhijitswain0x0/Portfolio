<style>
  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .contact-card {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--color-border-strong);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.95em;
    font-weight: 500;
    transition: background-color 0.2s, color 0.2s;
  }

  .contact-icon {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
  }

  .contact-card:hover,
  .contact-card:active {
    background-color: var(--color-fg);
    color: var(--color-bg);
  }

  @media (max-width: 480px) {
    .contact-grid {
      flex-direction: column;
      align-items: stretch;
    }

    .contact-card {
      justify-content: center;
    }
  }
</style>
