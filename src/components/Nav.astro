<style>
  .main-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-body);
    font-size: 0.95em;
    text-transform: uppercase;
    padding: 0.5rem 0;
    position: relative;
  }

  /* Hover invert effect */
  .nav-links a:hover {
    background-color: var(--color-fg);
    color: var(--color-bg);
    padding: 0.5rem 0.75rem;
  }

  /* Responsive adjustments */
  @media (max-width: 680px) {
    .main-nav {
      flex-direction: column;
      border-bottom: none;
    }

    .nav-links {
      margin-top: 1.5rem;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      padding: 0.25rem 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .nav-links {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
