<nav class="main-nav container">
  <details class="nav-dropdown">
    <summary>navbar/</summary>
  </details>
  <ul class="nav-links">
    <li><a href="#home">[Home]</a></li>
    <li><a href="#projects">[Projects]</a></li>
    <li><a href="#about">[About]</a></li>
    <li><a href="#contact">[Contact]</a></li>
  </ul>
</nav>

<style>
  .main-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .nav-dropdown {
    display: none;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-body);
    font-size: 0.95em;
    text-transform: uppercase;
    padding: 0.5rem 0;
    position: relative;
  }

  /* Hover invert effect */
  .nav-links a:hover,
  .nav-links a:active {
    background-color: var(--color-fg);
    color: var(--color-bg);
    padding: 0.5rem 0.75rem;
  }

  @media (max-width: 680px) {
    .main-nav {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    /* Full-scale dropdown on mobile */
    .nav-dropdown {
      display: block;
      width: 100%;
      border: 1px solid var(--color-border-strong);
      touch-action: manipulation;
    }

    .nav-dropdown summary {
      list-style: none;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 0.95em;
      text-transform: uppercase;
      padding: 0.75rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
    }

    .nav-dropdown summary::-webkit-details-marker {
      display: none;
    }

    .nav-dropdown summary::after {
      content: "+";
    }

    .nav-dropdown[open] summary::after {
      content: "-";
    }

    .nav-dropdown summary:active {
      background-color: var(--color-fg);
      color: var(--color-bg);
    }

    .nav-links {
      display: none;
      flex-direction: column;
      gap: 0;
      width: 100%;
      border: 1px solid var(--color-border-strong);
      border-top: none;
    }

    .nav-dropdown[open] ~ .nav-links {
      display: flex;
    }

    .nav-links li {
      border-top: 1px solid var(--color-border);
    }

    .nav-links a {
      display: block;
      width: 100%;
      padding: 0.75rem 1rem;
    }

    .nav-links a:hover,
    .nav-links a:active {
      padding: 0.75rem 1rem;
      background-color: var(--color-fg);
      color: var(--color-bg);
    }
  }
</style>
