---
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="panel reveal container">
  <div class="panel-header">
    <div class="panel-dots">
      <span class="dot"></span><span class="dot"></span><span class="dot"
      ></span>
    </div>
    <div class="panel-label">projects/</div>
  </div>
  <div class="panel-content projects-grid">
    <ProjectCard
      title="GitPal"
      roleLabel="Team Lead | Lead Devloper"
      description="A visual Git wrapper that turns branches, commits and merges into something a first-time developer can actually read — with real-time collaboration built in."
      tags={["Developer Tool", "Web and Desktop app", "Git internals"]}
    />

    <ProjectCard
      title="Blink"
      roleLabel="Team Lead | Lead Devloper"
      description="Lightweight desktop AI utility focused on instant chats through a Raycast-like floating window system."
      tags={["Artificial Intelligence", "Utility", "Productivity"]}
    />
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
