---

<div id="boot-overlay" class="boot-overlay">
  <pre
    class="boot-terminal"><span id="boot-output" /><span class="boot-cursor">_</span></pre>
  <button id="skip-boot" class="skip-button">skip &gt;&gt;</button>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const bootOverlay = document.getElementById("boot-overlay");
    const bootOutput = document.getElementById("boot-output");
    const skipButton = document.getElementById("skip-boot");

    const messages = [
      "> [OK] Establishing connection to host",
      "> [OK] Collecting Assets",
      "> [INFO] Astro framework detected",
      "> [OK] Building DOM",
      "> [INFO] Authorised as visitor",
      "> Booting...",
    ];

    let messageIndex = 0;
    let charIndex = 0;
    const typingSpeed = 220; // milliseconds per message

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const typeMessage = () => {
      if (messageIndex < messages.length) {
        if (charIndex < messages[messageIndex].length) {
          bootOutput.textContent += messages[messageIndex][charIndex];
          charIndex++;
          setTimeout(typeMessage, 10);
        } else {
          bootOutput.textContent += "\n"; // Newline after each message
          messageIndex++;
          charIndex = 0;
          setTimeout(typeMessage, typingSpeed);
        }
      } else {
        // All messages typed, fade out overlay
        bootOverlay.style.opacity = "0";
        bootOverlay.addEventListener(
          "transitionend",
          () => {
            bootOverlay.style.display = "none";
          },
          { once: true },
        );
      }
    };

    const skipAnimation = () => {
      bootOutput.textContent = messages.join("\n") + "\n";
      bootOverlay.style.opacity = "0";
      bootOverlay.addEventListener(
        "transitionend",
        () => {
          bootOverlay.style.display = "none";
        },
        { once: true },
      );
    };

    skipButton.addEventListener("click", skipAnimation);

    if (prefersReducedMotion) {
      skipAnimation();
    } else {
      typeMessage();
    }
  });
</script>

<style>
  .boot-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg);
    color: var(--color-fg);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 1;
    transition: opacity 0.35s ease-out;
    flex-direction: column;
  }

  .boot-terminal {
    font-family: var(--font-body);
    font-size: 1.1em;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .boot-cursor {
    animation: blink 1s steps(1) infinite;
    display: inline-block;
    width: 0.7em;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .skip-button {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background-color: transparent;
    border: 1px solid var(--color-border-strong);
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.9em;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .skip-button:hover,
  .skip-button:active {
    background-color: var(--color-fg);
    color: var(--color-bg);
  }
</style>
